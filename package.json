  "description": "Accountability and content versioning for Strapi v5+ with enhanced UI, field-level restoration and auto-refresh",
  "homepage": "https://github.com/PenguinOfWar/strapi-plugin-paper-trail#readme",
  "bugs": {
    "url": "https://github.com/PenguinOfWar/strapi-plugin-paper-trail/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PenguinOfWar/strapi-plugin-paper-trail.git"
  },
  "license": "MIT",
  "author": {
    "name": "Darryl Walker",
    "email": "darryljwalker@me.com"
  },
  "maintainers": [
    {
      "name": "Darryl Walker"
    }
  ],
  "contributors": [
    {
      "name": "Brianggalvez",
      "url": "https://github.com/Brianggalvez"
    },
    {
      "name": "robsonpiere",
      "url": "https://github.com/robsonpiere"
    },
    {
      "name": "redondi88",
      "url": "https://github.com/redondi88"
    },
    {
      "name": "BrOrlandi",
      "url": "https://github.com/BrOrlandi"
    }
  ],
  "scripts": {
    "lint": "eslint admin/src server",
    "test": "jest",
    "todo": "leasot -x --reporter markdown '{admin,server}/**/*' --ignore '**/*.+(jpg|jpeg|gif|png|svg|json)' > todo.md",
    "build": "strapi plugin:build",
    "verify-build": "node build-verify.js",
    "prepublishOnly": "npm run build && npm run verify-build",
    "publish:dev": "npm publish --tag dev"
  },
  "dependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/helper-plugin": "^5.0.0",
    "@strapi/icons": "^2.0.0",
    "path-to-regexp": "^6.2.1",
    "prop-types": "^15.7.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.5.0",
    "leasot": "^13.3.0",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "styled-components": "^5.3.11"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.20.0",
    "styled-components": "^5.3.11"
  },
  "engines": {
    "node": ">=18.0.0 <=20.x.x",
    "npm": ">=8.0.0"
  },
  "strapi": {
    "name": "paper-trail",
    "description": "Accountability and content versioning for Strapi v5+ with enhanced UI, field-level restoration and auto-refresh",
    "kind": "plugin",
    "displayName": "Paper Trail"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./admin/src/index.jsx",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./strapi-admin": {
      "source": "./admin/src/index.jsx",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/index.js",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  }
}
